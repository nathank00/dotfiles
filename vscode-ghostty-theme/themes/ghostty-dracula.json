  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#C5BDE4", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#C96A00" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#9B7EDB" }
    },
    {
      "scope": ["keyword", "keyword.control", "keyword.operator", "storage"],
      "settings": { "foreground": "#C44DA4" }
    },
    {
      "scope": ["storage.type", "storage.modifier"],
      "settings": { "foreground": "#7C5CBF", "fontStyle": "italic" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#2DA44E" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "entity.name.tag"],
      "settings": { "foreground": "#0E7490", "fontStyle": "italic" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#9B7EDB" }
    },
    {
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": { "foreground": "#2D2B55" }
    },
    {
      "scope": ["variable.language"],
      "settings": { "foreground": "#9B7EDB", "fontStyle": "italic" }
    },
    {
      "scope": ["support.type.property-name", "meta.object-literal.key"],
      "settings": { "foreground": "#C44DA4" }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": { "foreground": "#A89CC8" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#D63F3F" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "foreground": "#7C5CBF", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#C96A00", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#C44DA4", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#2DA44E" }
    },
    {
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#0E7490" }
    },
    {
      "scope": ["support.type.primitive", "support.type"],
      "settings": { "foreground": "#0E7490", "fontStyle": "italic" }
    }
  ]
}
