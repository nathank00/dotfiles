# i3status: what the right side of the top bar shows

general {
    output_format = "i3bar"
    colors = true
    markup = "pango"
    color_good = "#8a8a8a"
    color_degraded = "#8a8a8a"
    color_bad = "#4a4a4a"
    interval = 5
}

order += "volume master"
order += "cpu_usage"
order += "memory"
order += "tztime date"
order += "tztime time"

volume master {
    format = "vol %volume"
    format_muted = "muted"
    device = "pulse"
    separator_block_width = 28
}

cpu_usage {
    format = "cpu %usage"
    separator_block_width = 28
}

memory {
    format = "mem %used"
    threshold_degraded = "10%"
    format_degraded = "mem %used"
    separator_block_width = 28
}

tztime date {
    format = "%a %d %b"
    separator_block_width = 28
}

tztime time {
    format = "<span foreground='#e5e5e5'>%H:%M</span>"
    separator_block_width = 6
}
