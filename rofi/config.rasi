configuration { modi: "drun,run,window"; show-icons: false; font: "JetBrains Mono 12"; }
* { bg: #0a0a0a; bg-alt: #1a1a1a; fg: #c8c8c8; accent: #3b82f6;
    background-color: @bg; text-color: @fg; }
window { width: 560px; location: center; anchor: center;
         border: 2px; border-color: @accent; border-radius: 0; }
mainbox { padding: 12px; }
inputbar { children: [ prompt, entry ]; spacing: 8px; padding: 0 0 10px 0; }
prompt { text-color: @accent; }
listview { lines: 8; scrollbar: false; }
element { padding: 6px 8px; }
element selected { background-color: @bg-alt; text-color: @accent; }
element-text { background-color: inherit; text-color: inherit; }
