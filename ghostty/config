# Ghostty config — Dracula theme, matches WezTerm setup

font-family = Hack
font-size = 13

# Dracula colors
background = #282A36
foreground = #F8F8F2
cursor-color = #BD93F9
selection-background = #44475A
selection-foreground = #F8F8F2

palette = 0=#21222C
palette = 1=#FF5555
palette = 2=#50FA7B
palette = 3=#F1FA8C
palette = 4=#BD93F9
palette = 5=#FF79C6
palette = 6=#8BE9FD
palette = 7=#F8F8F2
palette = 8=#6272A4
palette = 9=#FF6E6E
palette = 10=#69FF94
palette = 11=#FFFFA5
palette = 12=#D6ACFF
palette = 13=#FF92DF
palette = 14=#A4FFFF
palette = 15=#FFFFFF

# Window
background-opacity = 0.8
window-padding-x = 12
window-padding-y = 2

# Shift+Esc types ~ (for a compact keyboard where Esc and ~ share a key)
keybind = shift+escape=text:~

shell-integration = zsh
window-inherit-working-directory = true

# --- macOS only (Linux ignores macos-* options) ---
# Tabs live in the title bar
macos-titlebar-style = tabs

# --- Linux only (macOS ignores gtk-* options) ---
# Same layout as the Mac: tabs merged into the title bar, no separate tab strip
gtk-titlebar = true
gtk-titlebar-style = tabs
gtk-toolbar-style = flat
# Compact tabs sized to their titles instead of stretching across the bar
gtk-wide-tabs = false
# Colors and shape of the title bar and tabs. The file is linked next to this
# config by install.sh on Linux only; ? skips it quietly if it is missing.
gtk-custom-css = ?tabs.css
# Transparency on Linux also needs a compositor (picom, started from i3/config)
