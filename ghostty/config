# Ghostty config — Dracula theme, matches WezTerm setup

font-family = Hack
font-size = 13

# Dracula colors
background = #282A36
foreground = #F8F8F2
cursor-color = #BD93F9
selection-background = #44475A
selection-foreground = #F8F8F2

palette = 0=#21222C
palette = 1=#FF5555
palette = 2=#50FA7B
palette = 3=#F1FA8C
palette = 4=#BD93F9
palette = 5=#FF79C6
palette = 6=#8BE9FD
palette = 7=#F8F8F2
palette = 8=#6272A4
palette = 9=#FF6E6E
palette = 10=#69FF94
palette = 11=#FFFFA5
palette = 12=#D6ACFF
palette = 13=#FF92DF
palette = 14=#A4FFFF
palette = 15=#FFFFFF

# Window
background-opacity = 0.8
window-padding-x = 12
window-padding-y = 2

# Linux (GTK) only: no title bar. Has no effect on macOS.
gtk-titlebar = false

# Shift+Esc types ~ (for a compact keyboard where Esc and ~ share a key)
keybind = shift+escape=text:~

# Tabs
macos-titlebar-style = tabs

shell-integration = zsh
window-inherit-working-directory = true
